{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "healthcheck": {
      "path": "/api/health",
      "interval": 30,
      "timeout": 10
    },
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}